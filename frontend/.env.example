# Base URL of the deployed HTTP API (no trailing slash).
# Leave blank to call same-origin paths.
VITE_API_URL=

# Cognito user pool. When both are set, sign-in goes through Amplify and the
# session is a real JWT. When either is missing the login page falls back to
# demo personas and the top bar marks the session "Demo auth".
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# "true" shows the floating demo toolbar (Run sweep now / Reset demo) and the
# persona switcher in the top bar. Anything else hides both, so a production
# build never ships a button that wipes the table.
VITE_DEMO_MODE=false
